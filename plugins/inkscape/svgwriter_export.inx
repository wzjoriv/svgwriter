<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Save with svgwriter</name>
  <id>org.svgwriter.export</id>
  <dependency type="file" location="inx">svgwriter_extension.py</dependency>
  <param name="output" type="path" mode="file_new" gui-text="Save as:"></param>
  <param name="format" type="optiongroup" appearance="combo" gui-text="Format:">
    <option value="auto">From the file extension</option>
    <option value="pptx">PowerPoint (.pptx, with animations)</option>
    <option value="docx">Word (.docx)</option>
    <option value="pdf">PDF (.pdf)</option>
    <option value="tikz">TikZ (.tikz)</option>
    <option value="eps">EPS (.eps)</option>
    <option value="gcode">G-code (.gcode)</option>
    <option value="hpgl">HPGL (.hpgl)</option>
    <option value="dxf">DXF (.dxf)</option>
    <option value="html">HTML page (.html)</option>
    <option value="png">PNG (.png)</option>
    <option value="gif">GIF, animated (.gif)</option>
    <option value="webp">WebP (.webp)</option>
    <option value="excalidraw">Excalidraw (.excalidraw)</option>
  </param>
  <param name="options" type="string" gui-text="Options (name=value, comma separated):"></param>
  <label>Options are passed to the exporter, for example dpi=300 for images or feed=1200 for G-code. The drawing in Inkscape is not changed.</label>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="svgwriter"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">svgwriter_export.py</command>
  </script>
</inkscape-extension>
