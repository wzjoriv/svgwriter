class ColorMatrixType(str, Enum):
    MATRIX = 'matrix'
    SATURATE = 'saturate'
    HUE_ROTATE = 'hueRotate'
    LUMINANCE_TO_ALPHA = 'luminanceToAlpha'

class EdgeMode(str, Enum):
    DUPLICATE = 'duplicate'
    WRAP = 'wrap'
    NONE = 'none'

class Channel(str, Enum):
    R = 'R'
    G = 'G'
    B = 'B'
    A = 'A'
    RED = R
    GREEN = G
    BLUE = B
    ALPHA = A

class MorphologyOperator(str, Enum):
    ERODE = 'erode'
    DILATE = 'dilate'

class TurbulenceType(str, Enum):
    FRACTAL_NOISE = 'fractalNoise'
    TURBULENCE = 'turbulence'

