        xml_space: XmlSpace | None = None,
        id: str | None = None,
        attrs: Mapping[str, AttrValue] | None = None,
        **kwargs: Any,
    ) -> None: ...
    @property
    def result(self) -> str: ...
    def sources(self) -> list[FilterPrimitive]: ...
    def __rshift__(self, other: FilterPrimitive) -> FilterPrimitive: ...

