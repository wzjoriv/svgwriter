from dataclasses import dataclass
from ..elements.core import Element

__all__ = ["IRI", "FuncIRI", "parse_func_iri"]

@dataclass(frozen=True)
class IRI:
    target: str
    element: Element | None = None

    def __init__(self, target: str, element: Element | None = None) -> None: ...
    @classmethod
    def local(cls, element_id: str) -> IRI: ...
    @property
    def fragment(self) -> str | None: ...
    @property
    def current(self) -> str: ...
    def svg_value(self, precision: int = 4) -> str: ...
    def __str__(self) -> str: ...

@dataclass(frozen=True)
class FuncIRI(IRI):
    def __init__(self, target: str, element: Element | None = None) -> None: ...
    def svg_value(self, precision: int = 4) -> str: ...

def parse_func_iri(text: str) -> FuncIRI | None: ...
