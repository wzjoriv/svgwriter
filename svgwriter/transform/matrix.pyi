import numpy as np
from dataclasses import dataclass
from typing import Any, Final, NamedTuple, overload
from numpy import ndarray
from .._internal._drawable import Drawable
from .._internal._typing import Matrix6

__all__ = ["IDENTITY", "Matrix", "Point"]

class Point(NamedTuple):
    x: float
    y: float

    def __add__(self, other: object) -> Point: ...
    def __radd__(self, other: object) -> Point: ...
    def __sub__(self, other: object) -> Point: ...
    def __rsub__(self, other: object) -> Point: ...
    def __mul__(self, other: object) -> Point: ...
    def __rmul__(self, other: object) -> Point: ...
    def __truediv__(self, other: object) -> Point: ...
    def __neg__(self) -> Point: ...
    def __abs__(self) -> float: ...

@dataclass(frozen=True, slots=True)
class Matrix(Drawable):
    a: float = 1.0
    b: float = 0.0
    c: float = 0.0
    d: float = 1.0
    e: float = 0.0
    f: float = 0.0

    def __init__(
        self,
        a: float = 1.0,
        b: float = 0.0,
        c: float = 0.0,
        d: float = 1.0,
        e: float = 0.0,
        f: float = 0.0,
    ) -> None: ...
    @classmethod
    def translate(cls, tx: float, ty: float = 0.0) -> Matrix: ...
    @classmethod
    def scale(cls, sx: float, sy: float | None = None) -> Matrix: ...
    @classmethod
    def rotate(
        cls,
        angle: float,
        cx: float = 0.0,
        cy: float = 0.0,
    ) -> Matrix: ...
    @classmethod
    def flip_x(cls, x: float = 0.0) -> Matrix: ...
    @classmethod
    def flip_y(cls, y: float = 0.0) -> Matrix: ...
    @classmethod
    def skew_x(cls, angle: float) -> Matrix: ...
    @classmethod
    def skew_y(cls, angle: float) -> Matrix: ...
    @overload
    def __matmul__(self, other: Matrix) -> Matrix: ...
    @overload
    def __matmul__(self, other: Point | tuple[float, float]) -> Point: ...
    @overload
    def __matmul__(self, other: np.ndarray) -> np.ndarray: ...
    @property
    def determinant(self) -> float: ...
    @property
    def is_identity(self) -> bool: ...
    def inverse(self) -> Matrix: ...
    def apply(self, x: float, y: float) -> Point: ...
    def apply_points(self, points: ndarray) -> ndarray: ...
    @classmethod
    def from_array(cls, array: object) -> Matrix: ...
    def as_tuple(self) -> Matrix6: ...
    def isclose(self, other: Matrix | object, tolerance: float = 1e-09) -> bool: ...
    def decompose(self) -> tuple[float, float, float, float, float, float]: ...
    def svg_value(
        self,
        precision: int = 4,
        *,
        pivot: tuple[float, float] | None = None,
        box: Any = None,
    ) -> str: ...
    def __str__(self) -> str: ...

IDENTITY: Final = ...
